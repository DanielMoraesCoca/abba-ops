  "rules": [
    {
      "id": "primeiro-cafe",
      "kind": "regex",
      "pattern": "primeiro\\s+caf[ée]",
      "flags": "gi",
      "severity": "block",
      "unless": [],
      "allowQuotedInTables": true,
      "reason": "Expressão vetada pelo sócio (V3n, 2026-08-05): 'do primeiro café' é inapropriada em material. A forma aprovada é 'da primeira conversa'.",
      "doc": "05-interno/registro-de-decisoes.md (V3n)"
    },
    {
      "id": "firma-nova-em-material",
