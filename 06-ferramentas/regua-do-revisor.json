      "flags": "gi",
      "unless": [
        "monitoramento\\s+(automatizado\\s+)?24/7",
        "[Nn]unca\\s*\\|",
        "frase\\s+proibida",
        "o\\s+que\\s+nunca\\s+dizemos",
        "n[ãa]o\\s+dizemos",
        "Em\\s+vez\\s+disso"
      ],
      "severity": "block",
      "reason": "'Suporte 24/7' é frase proibida (P9): SLA honesto para equipe de 2 = monitoramento automatizado 24/7 + suporte humano 9h–18h úteis.",
      "doc": "04-entrega/sla-manutencao.md",
      "allowQuotedInTables": true
    },
    {
