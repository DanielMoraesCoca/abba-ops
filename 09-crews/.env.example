# Copie para .env e preencha. .env NAO entra no git.
# Nenhum segredo real neste arquivo — so os nomes.

# --- LLM -----------------------------------------------------------------
ANTHROPIC_API_KEY=
ABBA_MODELO_JULGAMENTO=claude-opus-5
ABBA_MODELO_CLASSIFICACAO=claude-haiku-4-5
ABBA_TETO_USD_POR_EXECUCAO=1.00

# --- Plataforma RTC (apuracao assistida) ---------------------------------
# Credencial gerada em "Gerar Credencial para API" no Portal do Piloto RTC-CBS.
# Procurador digital autorizado gera por empresa representada.
ABBA_RTC_CLIENT_ID=
ABBA_RTC_CLIENT_SECRET=
ABBA_RTC_BASE_URL=

# --- Certificado digital (Distribuicao DF-e) -----------------------------
# Caminho para o .p12 NO GERENCIADOR DE SEGREDOS, nunca no repositorio.
ABBA_CERT_A1_PATH=
ABBA_CERT_A1_SENHA=

# --- Ledger (assessment-brain) -------------------------------------------
ABBA_BRAIN_API_URL=
ABBA_BRAIN_API_TOKEN=

# --- CrewAI ---------------------------------------------------------------
# Telemetria desligada por padrao: este projeto toca dado fiscal de cliente.
CREWAI_TELEMETRY_OPT_OUT=true
